# Copy to demo/.env (git-ignored). Read by demo/providers.py at server start; existing environment variables win.
# GoodVision SmartRouter key — create it in the console (SmartRouter settings → Create API key)
# or at https://ai.goodvision.tech/keys. See demo/goodvision.md.
GOODVISION_API_KEY=
# Optional overrides
# GOODVISION_TEST_API_BASE=https://api-test.goodvision.tech/v1
# GOODVISION_API_BASE=https://api.goodvision.tech/v1
# GOODVISION_MODEL=claude-sonnet-5          # must match the model market verbatim; "auto" = SmartRouter picks
