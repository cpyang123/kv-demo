# systemd unit for the demo server on an Azure VM (demo/deploy/azure_vm_setup.sh installs it)
[Unit]
Description=Knowledge Vault x ChainSWE demo
After=network-online.target
Wants=network-online.target

[Service]
User=kvdemo
WorkingDirectory=/opt/kv/knowledge-vault-project
EnvironmentFile=/opt/kv/demo.env
ExecStart=/opt/kv/venv/bin/python demo/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
