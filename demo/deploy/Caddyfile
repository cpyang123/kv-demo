# TLS termination + password in front of the demo (docker-compose.yml mounts this file into the caddy service).
# DEMO_DOMAIN           the VM's DNS name (infra/main.bicep outputs <label>.<region>.cloudapp.azure.com)
# DEMO_BASIC_AUTH_HASH  output of `caddy hash-password --plaintext '<password>'` (bcrypt); user name "demo"
# For school single sign-on instead, put oauth2-proxy (Microsoft Entra provider) between caddy and demo.
{$DEMO_DOMAIN} {
    basic_auth {
        demo {$DEMO_BASIC_AUTH_HASH}
    }
    reverse_proxy demo:8765
    encode zstd gzip
}
